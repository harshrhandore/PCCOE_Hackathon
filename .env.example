# Browser-visible values. Never put secret keys in VITE_ variables.
VITE_API_BASE_URL=/api/v1
VITE_DATA_BASE_URL=/data
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_ORIGIN=http://127.0.0.1:8081
VITE_ENABLE_DEMO=true
VITE_VAPID_PUBLIC_KEY=
# Server/pipeline. Copy this file to .env locally; do not commit configured secrets.
APP_ENV=development
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173
DATABASE_URL=
# Local setup fills these ignored server-only administrator values for provisioning.
HEATGUARD_LOCAL_ADMIN_DATABASE_URL=
HEATGUARD_LOCAL_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Delivery must stay test. No Actual CAP or paid messaging route is implemented.
DELIVERY_MODE=test
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TEST_CHAT_IDS=
# Independent 32-byte base64 keys; see scripts/generate-keys.py. Do not reuse keys.
HANDLE_HMAC_KEY=
HANDLE_ENCRYPTION_KEY=
DELETION_TOKEN_HMAC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
RESEND_API_KEY=
EMAIL_FROM=
PIPELINE_DATA_DIR=./data
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
FORECAST_MODEL=best_match
CITY_TIMEZONE=Asia/Kolkata
SNAPSHOT_STALE_SECONDS=21600
ENABLE_ML=false
ENABLE_EMAIL=false
# Optional local Supabase: no hosted project is required.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
