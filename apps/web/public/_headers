/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org; font-src 'self'; connect-src 'self' http://localhost:8000 http://127.0.0.1:8000 https://tiles.openfreemap.org; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
/data/releases/*
  Cache-Control: public,max-age=31536000,immutable
/data/latest.json
  Cache-Control: public,max-age=60,must-revalidate
/data/diagnostic.json
  Cache-Control: public,max-age=60,must-revalidate
/index.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public,max-age=31536000,immutable
